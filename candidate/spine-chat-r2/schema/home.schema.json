{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proto-pilot:private-home:v1",
  "title": "Private pilot home; generic schema, never an access grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","homeId","version","storage","sources","decisions","obligations","learning","constraints","applied"],
  "properties": {
    "schema":{"const":"proto-pilot-home/v1"},
    "homeId":{"$ref":"#/$defs/id"},
    "version":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "storage":{"enum":["ALLOW","DENY"]},
    "sources":{"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/source"}},
    "decisions":{"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/decision"}},
    "obligations":{"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/obligation"}},
    "learning":{"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/learning"}},
    "constraints":{"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/constraint"}},
    "applied":{"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/applied"}}
  },
  "$defs": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"},
    "text":{"type":"string","minLength":1,"maxLength":16000},
    "optionalText":{"type":"string","maxLength":16000},
    "texts":{"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/text"}},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["id","name","aliases","function","scope","locator","revision","access","status"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/text"},
        "aliases":{"$ref":"#/$defs/texts"},"function":{"$ref":"#/$defs/text"},
        "scope":{"$ref":"#/$defs/text"},"locator":{"$ref":"#/$defs/text"},
        "revision":{"$ref":"#/$defs/optionalText"},
        "access":{"enum":["ALLOW","DENY","UNKNOWN"]},
        "status":{"enum":["CURRENT","STALE","UNKNOWN"]}
      }
    },
    "decision":{
      "type":"object","additionalProperties":false,
      "required":["id","scope","value","sourceId","sourceRevision","status","supersedes","basis"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"scope":{"$ref":"#/$defs/text"},"value":{"$ref":"#/$defs/text"},
        "sourceId":{"$ref":"#/$defs/id"},"sourceRevision":{"$ref":"#/$defs/text"},
        "status":{"enum":["ACTIVE","WITHDRAWN"]},
        "supersedes":{"type":"array","maxItems":5000,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "basis":{"enum":["VERIFIED","UNKNOWN"]}
      }
    },
    "book":{
      "type":"object","additionalProperties":false,
      "required":["sourceId","disposition","reason","evidence"],
      "properties":{
        "sourceId":{"$ref":"#/$defs/id"},"disposition":{"enum":["PENDING","WRITE","NO_POST","WAIT","WRITTEN"]},
        "reason":{"$ref":"#/$defs/optionalText"},"evidence":{"$ref":"#/$defs/optionalText"}
      },
      "allOf":[
        {"if":{"properties":{"disposition":{"enum":["NO_POST","WAIT"]}}},"then":{"properties":{"reason":{"$ref":"#/$defs/text"}}}},
        {"if":{"properties":{"disposition":{"const":"WRITTEN"}}},"then":{"properties":{"evidence":{"$ref":"#/$defs/text"}}}}
      ]
    },
    "obligation":{
      "type":"object","additionalProperties":false,
      "required":["id","scope","summary","sourceId","state","effect","nextTrigger","evidence","books"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"scope":{"$ref":"#/$defs/text"},"summary":{"$ref":"#/$defs/text"},
        "sourceId":{"$ref":"#/$defs/id"},"state":{"enum":["OPEN","WAITING","COMPLETED","WITHDRAWN"]},
        "effect":{"enum":["NONE","UNKNOWN","CONFIRMED"]},"nextTrigger":{"$ref":"#/$defs/optionalText"},
        "evidence":{"$ref":"#/$defs/optionalText"},"books":{"type":"array","maxItems":5000,"items":{"$ref":"#/$defs/book"}}
      },
      "allOf":[
        {"if":{"properties":{"state":{"const":"WAITING"}}},"then":{"properties":{"nextTrigger":{"$ref":"#/$defs/text"}}}},
        {"if":{"properties":{"state":{"const":"COMPLETED"}}},"then":{"properties":{"evidence":{"$ref":"#/$defs/text"},"books":{"items":{"properties":{"disposition":{"enum":["WRITTEN","NO_POST"]}}}}}}},
        {"if":{"properties":{"effect":{"const":"CONFIRMED"}}},"then":{"properties":{"evidence":{"$ref":"#/$defs/text"}}}}
      ]
    },
    "learning":{
      "type":"object","additionalProperties":false,
      "required":["id","scope","summary","sourceId","triggers","status","disposition","evidence"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"scope":{"$ref":"#/$defs/text"},"summary":{"$ref":"#/$defs/text"},
        "sourceId":{"$ref":"#/$defs/id"},"triggers":{"$ref":"#/$defs/texts"},
        "status":{"enum":["ACTIVE","WITHDRAWN"]},
        "disposition":{"enum":["PENDING","APPLIED","NOT_APPLICABLE","DEFERRED"]},"evidence":{"$ref":"#/$defs/optionalText"}
      },
      "allOf":[{"if":{"properties":{"status":{"const":"ACTIVE"}}},"then":{"properties":{"triggers":{"minItems":1}}}}]
    },
    "constraint":{
      "type":"object","additionalProperties":false,
      "required":["id","scope","text","sourceId","status"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"scope":{"$ref":"#/$defs/text"},"text":{"$ref":"#/$defs/text"},
        "sourceId":{"$ref":"#/$defs/id"},"status":{"enum":["ACTIVE","WITHDRAWN"]}
      }
    },
    "applied":{
      "type":"object","additionalProperties":false,"required":["id","canonical","version"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"canonical":{"$ref":"#/$defs/text"},
        "version":{"type":"integer","minimum":0,"maximum":9007199254740991}
      }
    }
  }
}
